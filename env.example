# LLM API 金鑰配置
# 至少需要設定一個 API 金鑰
OPENAI_API_KEY=YOUR_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Whisper 模型配置
# 可選: tiny, base, small, medium, large
# base 是平衡速度和準確性的好選擇
WHISPER_MODEL=base

# LLM 提供者配置
# 可選: openai、anthropic 或 gemini
DEFAULT_LLM_PROVIDER=openai

# OpenAI 模型配置
OPENAI_MODEL=gpt-4o-mini

# Anthropic 模型配置
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Gemini 模型配置
# 可選: gemini-1.5-flash（推薦，速度快）、gemini-1.5-pro（更強但較慢）
# 注意: gemini-pro 已棄用，請使用 gemini-1.5-flash 或 gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# 檔案處理配置
# 最大檔案大小（bytes），預設 500MB
MAX_FILE_SIZE=524288000

# 應用程式配置
DEBUG=false
